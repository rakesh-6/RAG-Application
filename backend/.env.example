# Copy this file to .env and fill in your own values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Storage ---
# Leave unset to use backend/data/ (uploads, chroma_db and app.db live there)
# DATA_DIR=
# Leave unset to use SQLite at <DATA_DIR>/app.db
# DATABASE_URL=sqlite:///C:/path/to/app.db

# --- Auth (used from Step 2) ---
# Generate one with: py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Uploads (used from Step 3) ---
MAX_UPLOAD_MB=10

# --- Gemini and RAG (used from Step 4) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
